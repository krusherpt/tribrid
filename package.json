{
  "name": "tribrid",
  "version": "0.1.0",
  "description": "Low-latency voice mesh bridge between Discord, Haven, and Fluxer (tincan-style: listens to all sides, transmits to all sides)",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^1.3.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "opusscript": "^0.1.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.3",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0",
    "@livekit/rtc-node": "^1.1.0",
    "sodium-native": "^4.3.1",
    "werift": "^0.22.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
