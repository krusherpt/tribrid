# tribrid — copy to .env and fill in what you have.
# A leg activates only when ALL of its required keys are set;
# partial leg config is skipped with a warning.

# ---------- Discord (all required for the Discord leg) ----------
# https://discord.com/developers/applications — bot token.
# Intent needed: Voice State (Guild Voice States). MESSAGE_CONTENT only if text bridge is on.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Optional: text channel where the bridge posts the cross-platform roster line
DISCORD_TEXT_CHANNEL_ID=
# Voice direction for this leg: both | in | out | off   (default: both)
DISCORD_BRIDGE=both

# ---------- Haven (all required for the Haven leg) ----------
# Base url of your Haven server, e.g. https://haven.example.com
HAVEN_URL=
# The 8-hex code of the voice channel (visible in the channel URL)
HAVEN_CHANNEL_CODE=
# Bot token = the TOKEN of a Haven webhook that has "can use voice" enabled
# (channel settings -> webhooks -> create -> token). Bot appears as that webhook.
HAVEN_BOT_TOKEN=
# Optional: text channel code for the roster line (webhook posts there)
HAVEN_TEXT_CHANNEL_CODE=
# ICE servers the bot uses for P2P with Haven users. For a LAN test [] is fine;
# for real users behind NAT you MUST provide a TURN server or remote users
# will not connect. Example:
# HAVEN_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"x","credential":"y"}]
HAVEN_ICE_SERVERS_JSON=[]
HAVEN_BRIDGE=both

# ---------- Fluxer (all required for the Fluxer leg) ----------
# Base url of the Fluxer instance, e.g. https://fluxer.example.com
FLUXER_URL=
FLUXER_BOT_TOKEN=
FLUXER_GUILD_ID=
FLUXER_VOICE_CHANNEL_ID=
FLUXER_TEXT_CHANNEL_ID=
FLUXER_BRIDGE=both

# ---------- Global ----------
# debug | info | warn | error
LOG_LEVEL=info
# Post "who is on which platform" line to the text channels
PRESENCE_ENABLED=1
PRESENCE_INTERVAL_S=10
